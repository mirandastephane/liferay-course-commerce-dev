INSERT INTO FRAGMENTENTRYLINK VALUES(100,0,'12311cc8-8c67-f489-870e-54f2ce62e847','12311cc8-8c67-f489-870e-54f2ce62e847',45450,32106,16796623585306,20122,'Clarity Admin','2024-08-15 18:28:55.000000','2026-07-02 20:53:04.225000','','','',93616,20031,26,26,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"config":{},"defaultValue":"\n\t<h1>HTML Example</h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained</strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea</em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t</p>\n","className":"com.liferay.journal.model.JournalArticle","classNameId":"29208","classPK":"45274","classTypeId":"30514","itemSubtype":"Basic Web Content","itemType":"Web Content Article","title":"Our Values","fieldId":"DDMStructure_content"}}}','wjjs',0,'BASIC_COMPONENT-html',1,'2026-07-02 20:53:04.225000',NULL)
