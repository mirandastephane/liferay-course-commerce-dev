/*C12*/INSERT INTO DDMTEMPLATEVERSION VALUES(0,0,103266,69131,16796623585306,20122,'Clarity Admin','2026-04-22 15:17:19.300000',31515,0,88318,'1.1','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Name language-id="en_US">Clarity B2B Search DT</Name></root>','','ftl','<style>\u000a\u0009.product-image .main-image {\u000a\u0009\u0009height: unset;\u000a\u0009\u0009margin-bottom: 0;\u000a\u0009}\u000a\u000a\u0009.custom-add-to-cart .add-to-cart-wrapper {\u000a\u0009\u0009display: flex !important;\u000a\u0009\u0009flex-direction: row !important;\u000a\u0009\u0009align-items: center !important;\u000a\u0009}\u000a\u000a\u0009.custom-add-to-cart .add-to-cart-wrapper div {\u000a\u0009\u0009margin-bottom: 0 !important;\u000a\u0009\u0009margin-right: 5px;\u000a\u0009}\u000a\u000a\u0009.custom-price .price-label {\u000a\u0009\u0009display: none !important;\u000a\u0009}\u000a\u000a\u0009.custom-price .price-value{\u000a\u0009\u0009text-align: left !important;\u000a\u0009}\u000a</style>\u000a<div class="pt-3">\u000a\u0009<div class="row mb-3">\u000a\u0009\u0009<div class="col-1">\u000a\u0009\u0009\u0009<strong>\u000a\u0009\u0009\u0009\u0009Image\u000a\u0009\u0009\u0009</strong>\u000a\u0009\u0009</div>\u000a\u0009\u0009<div class="col-3">\u000a\u0009\u0009\u0009<strong>\u000a\u0009\u0009\u0009\u0009Name\u000a\u0009\u0009\u0009</strong>\u000a\u0009\u0009</div>\u000a\u0009\u0009<div class="col-2">\u000a\u0009\u0009\u0009<div class="row">\u000a\u0009\u0009\u0009\u0009<div class="col-12">\u000a\u0009\u0009\u0009\u0009\u0009<strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009SKU\u000a\u0009\u0009\u0009\u0009\u0009</strong>\u000a\u0009\u0009\u0009\u0009</div>\u000a\u0009\u0009\u0009</div>\u000a\u0009\u0009</div>\u000a\u0009\u0009<div class="col-2">\u000a\u0009\u0009\u0009<strong>Price</strong>\u000a\u0009\u0009</div>\u000a\u0009\u0009<div class="col-4">\u000a\u0009\u0009\u0009<strong>Actions</strong>\u000a\u0009\u0009</div>\u000a\u0009</div>\u000a\u0009<#if